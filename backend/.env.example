# --- SQL Server ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=agrimatch
DB_DRIVER=ODBC Driver 17 for SQL Server
# yes = Windows Authentication (ไม่ใช้ user/password), no = SQL login ด้านล่าง
DB_TRUSTED_CONNECTION=yes
DB_USER=sa
DB_PASSWORD=your-sql-password

# Email delivery (Gmail: use an App Password, not the account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
EMAIL_OTP_SECRET=replace-with-a-long-random-secret
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_RESEND_SECONDS=60
